module StateMachine (
    input  wire       clk,
    input  wire       rst,
    input  wire [2:0] opcode,
    output reg  [2:0] alu_control,
    output reg        write_enable,
    output reg        select_data_source,
    output reg        pc_inc,
    output reg        clr
);

    localparam RESET   = 2'b00,
               FETCH   = 2'b01,
               DECODE  = 2'b10,
               EXECUTE = 2'b11;

    reg [1:0] current_state, next_state;

    always @(posedge clk or posedge rst) begin
        if (rst)
            current_state <= RESET;
        else
            current_state <= next_state;
    end

    always @(*) begin
        case (current_state)
            RESET:   next_state = FETCH;
            FETCH:   next_state = DECODE;
            DECODE:  next_state = EXECUTE;
            EXECUTE: next_state = FETCH;
            default: next_state = RESET;
        endcase
    end

    always @(*) begin
        alu_control        = 3'b000;
        write_enable       = 1'b0;
        select_data_source = 1'b0;
        pc_inc             = 1'b0;
        clr                = 1'b0;

        case (current_state)
            RESET: begin
                clr = 1'b1;
            end
            FETCH: begin
                clr          = 1'b0;
                pc_inc       = 1'b0;
                write_enable = 1'b0;
            end
            DECODE: begin
                alu_control = opcode;
            end
            EXECUTE: begin
                write_enable       = 1'b1;
                select_data_source = 1'b0;
                pc_inc             = 1'b1;
            end
        endcase
    end

endmodule

module StateMachine_tb;

    reg        clk;
    reg        rst;
    reg  [2:0] opcode;
    wire [2:0] alu_control;
    wire       write_enable;
    wire       select_data_source;
    wire       pc_inc;
    wire       clr;

    StateMachine uut (
        .clk                (clk),
        .rst                (rst),
        .opcode             (opcode),
        .alu_control        (alu_control),
        .write_enable       (write_enable),
        .select_data_source (select_data_source),
        .pc_inc             (pc_inc),
        .clr                (clr)
    );
    initial begin
        clk = 0;
    forever #5 clk = ~clk;
    end

    initial begin
        rst    = 1;
        opcode = 3'b000;
        #12;

        rst = 0;

        opcode = 3'b010;
        #30;

        opcode = 3'b101;
        #30;

        rst = 1;
        #10;
        rst = 0;
        #20;

    end

endmodule
